ndition":"既存checkerでnginxのactiveを確認。","raw_points":1,"role":"web","title":"Nginx起動"},"WEB02_PUBLIC_HTTP":{"pass_condition":"既存checkerでCloudShellからpublic IP経由の200と本文完全一致。","raw_points":1,"role":"web","title":"外部からHTTP"},"WEB02_REPO_PREREQUISITE":{"pass_condition":"既存checkerのrepo/release照合。","raw_points":0,"role":"web","title":"配布元"},"WEB03_AXFR_DENIED":{"pass_condition":"通常問い合わせが同じ回に成功する踏み台/WebからAXFRが明示拒否される。timeoutだけではPASSにしない。","raw_points":1,"role":"dns","title":"zone転送拒否"},"WEB03_CLIENT_ACL":{"pass_condition":"BINDのquery/recursion/cache ACLがlocalhost・踏み台・Webのみを許す実効設定になっている。SGだけの遮断でBIND ACLの実証としない。","raw_points":1,"role":"dns","title":"問い合わせ制限"},"WEB03_CONFIG_VALID":{"pass_condition":"named設定とlab.test zoneの構文検査が成功する。","raw_points":1,"role":"dns","title":"DNS構文"},"WEB03_DB_NAME":{"pass_condition":"Webの通常resolverでP/M別DB名が10.20.2.20になる。","raw_points":1,"role":"web","title":"DB名の通常解決"},"WEB03_FORWARD_ONLY":{"pass_condition":"forward only/転送先10.20.0.2の実効設定と外部名解決を確認する。外部Web接続成功は要求しない。","raw_points":1,"role":"dns","title":"外部名の転送"},"WEB03_NAMED_HTTP":{"pass_condition":"踏み台の通常resolverを使い、P/M別host名と既存HTTP fileで200/正しい本文を確認する。","raw_points":1,"role":"bastion","title":"名前によるHTTP"},"WEB03_NORMAL_RESOLVER":{"pass_condition":"踏み台/Webの通常resolverがBINDだけを使い、対象名をhostsやbrowser DoHで代用しない。","raw_points":1,"role":"bastion","title":"通常resolver"},"WEB03_NXDOMAIN":{"pass_condition":"その回で作る未登録lab.test名に権威NXDOMAINが返る。","raw_points":1,"role":"dns","title":"未登録名"},"WEB03_REQUIRED_RECORDS":{"pass_condition":"P/M別の必須record全件が期待private IPを返す。6名を6点へ水増ししない。追加の正当な練習名を許す。","raw_points":1,"role":"dns","title":"必要なA record"},"WEB03_SERVICE":{"pass_condition":"BINDがactiveである。","raw_points":1,"role":"dns","title":"BIND起動"},"WEB03_TCP_RESPONSE":{"pass_condition":"踏み台・Webの両方からTCP53で必要な回答が得られる。","raw_points":1,"role":"dns","title":"TCP応答"},"WEB03_UDP_RESPONSE":{"pass_condition":"踏み台・Webの両方からUDP53で必要な回答が得られる。","raw_points":1,"role":"dns","title":"UDP応答"},"WEB03_ZONE_AUTHORITY":{"pass_condition":"lab.testのSOA/NSと権威応答が設計と一致する。","raw_points":1,"role":"dns","title":"権威zone"},"WEB04_CAPACITY_READINESS":{"pass_condition":"空き20%以上かつ2GiB以上。提供済み容量を学生の構築点にしない。","raw_points":0,"role":"web","title":"提供容量"},"WEB04_MARKER_CONTENT":{"pass_condition":"学生が作ったP/M別markerのpath・匿名Lab ID・task・本文が一致する。","raw_points":1,"role":"web","title":"保存内容"},"WEB04_MARKER_PERMISSIONS":{"pass_condition":"markerはroot:root/0644、親directoryは0755である。","raw_points":1,"role":"web","title":"保存fileの権限"},"WEB04_STOP_START_RETENTION":{"pass_condition":"同じ配備の停止前/停止状態/再開後の証跡で、元instance/volumeとmarker hashが同じ、boot IDが変化したことを確認。単なるrebootや旧fixture記録では代用しない。","raw_points":1,"role":"web","title":"停止再開後の保持"},"WEB04_VOLUME_READINESS":{"pass_condition":"Webの対象pathが本人の元root volume上にあり、別volume/置換instanceでない。","raw_points":0,"role":"web","title":"提供volumeの対応"},"WEB05_BAD_PASSWORD_DENIED":{"pass_condition":"同じ回の正規接続を対照に、1回の誤password接続が明示認証拒否される。秘密値やhashは返さない。","raw_points":1,"role":"web","title":"誤password拒否"},"WEB05_CLUSTER_ACTIVE":{"pass_condition":"PostgreSQL16/mainがactiveである。","raw_points":1,"role":"db","title":"DB起動"},"WEB05_CLUSTER_CONFIG":{"pass_condition":"16/mainの設定・標準data directory・postgres/socket peer管理が妥当である。","raw_points":1,"role":"db","title":"cluster設定"},"WEB05_DATABASE_OWNER":{"pass_condition":"P/M別DBとpublic schemaのownerが対応するsetup roleである。","raw_points":1,"role":"db","title":"DBとschemaの所有者"},"WEB05_HBA_SCRAM":{"pass_condition":"pg_hbaはWeb /32・列挙したprofile DB/roleだけにSCRAMを許可し、それ以外の広い許可がない。","raw_points":1,"role":"db","title":"接続認証規則"},"WEB05_LISTEN_5432":{"pass_condition":"10.20.2.20:5432で待ち受ける。","raw_points":1,"role":"db","title":"DB待受"},"WEB05_ROLE_ATTRIBUTES":{"pass_condition":"対応runtime roleはLOGIN。両roleにsuperuser/CREATEDB/CREATEROLE/REPLICATION/BYPASSRLSや昇格membershipがない。setupは構築中LOGIN/完成後NOLOGINの両段階を認める。","raw_points":1,"role":"db","title":"DB role"},"WEB05_WEB_SQL":{"pass_condition":"Pはprivate IP、Mは通常DNS名からruntime roleで新規認証接続し、current_database/current_user/SELECT結果が一致する。","raw_points":1,"role":"web","title":"Webの認証SQL"},"WEB05_WRONG_TARGET_DENIED":{"pass_condition":"Webからpostgres role・許可外DB・他profileへの接続をHBA等で明示拒否する。未作成practice DB自体は必須にしない。","raw_points":1,"role":"web","title":"他DB/管理role拒否"},"WEB06_ADMIN_ENTRY":{"pass_condition":"通常DNSのadmin.lab.test:8080/admin/に踏み台から到達し、正しいログイン画面が返る。","raw_points":1,"role":"bastion","title":"管理入口"},"WEB06_ARTIFACTS":{"pass_condition":"教員配布コード・依存・固定版が一致する。学生はアプリコードを書かない。","raw_points":1,"role":"web","title":"アプリ資源"},"WEB06_CREATE_REFLECT":{"pass_condition":"同じ自動確認回で専用nonceの架空備品1件を管理HTTPから登録し、PostgreSQLと一般画面の値が一致する。","raw_points":1,"role":"bastion","title":"新規登録と反映"},"WEB06_EDIT_REFLECT":{"pass_condition":"その回にchecker自身が作った専用備品だけの数量を変更し、DBと一般画面の更新が一致する。","raw_points":1,"role":"bastion","title":"編集と反映"},"WEB06_LOGOUT":{"pass_condition":"同じsessionをPOSTでログアウトし、そのcookieを再使用しても管理画面は再認証を要求する。","raw_points":1,"role":"bastion","title":"ログアウト"},"WEB06_LOOPBACK":{"pass_condition":"Gunicornが127.0.0.1:8000のみで待ち受ける。","raw_points":1,"role":"web","title":"内部アプリ待受"},"WEB06_MIGRATIONS":{"pass_condition":"教員固定migrationと11table/必要sequenceが対象DBに揃う。","raw_points":1,"role":"db","title":"tableとmigration"},"WEB06_PASSWORD_LOGIN":{"pass_condition":"対話型自動確認で実passwordと正しいCSRF/session処理によって対象staffとしてHTTPログインする。force_loginやsession直書きを使わない。","raw_points":1,"role":"bastion","title":"実認証ログイン"},"WEB06_PROFILE_DATABASE":{"pass_condition":"app.envと実接続が選択profileのDB/runtime roleを通常DNSで使う。M4の単体SQL接続とは別にアプリ実接続を確認。","raw_points":1,"role":"web","title":"アプリDB接続"},"WEB06_PUBLIC_DATA":{"pass_condition":"一般80のHTTP200と公開対象の値がDBと一致する。固定HTMLのみではPASSにしない。","raw_points":1,"role":"bastion","title":"一般画面のDB反映"},"WEB06_REQUIRED_RECORDS":{"pass_condition":"P/M別の指定2件が対象DBに期待値で保存される。必須部分集合として照合する。","raw_points":1,"role":"db","title":"指定備品の保存"},"WEB06_SERVICE":{"pass_condition":"systemd serviceがactive/enabledで、設計の専用catalog userで起動する。","raw_points":1,"role":"web","title":"アプリservice"},"WEB06_STATIC":{"pass_condition":"一般/管理画面に必要なCSS等が正しい入口から取得でき、Content-Typeも妥当である。","raw_points":1,"role":"bastion","title":"静的資源"},"WEB07_ADMIN_PERMISSIONS":{"pass_condition":"対象管理者はstaffかつ非superuser、備品view/add/changeのみ。削除・user/group管理権限やrouteがない。","raw_points":1,"role":"web","title":"アプリ管理者の範囲"},"WEB07_ANONYMOUS_DENIED":{"pass_condition":"正規routeと妥当なCSRF条件で匿名の登録/編集を試し、認証を要求して対象DBを書き換えない。同じ回の正規ログイン/登録成功を対照にする。","raw_points":1,"role":"bastion","title":"匿名更新の拒否"},"WEB07_AUDIT_PRIVILEGES":{"pass_condition":"django_admin_logはSELECT/INSERTのみ。UPDATE/DELETEを許さない。","raw_points":1,"role":"db","title":"管理logの権限"},"WEB07_AUTH_LOOKUP_PRIVILEGES":{"pass_condition":"auth_group/auth_permission/関連中間table/content_typeはSELECTのみ。","raw_points":1,"role":"db","title":"認証参照の権限"},"WEB07_AUTH_USER_PRIVILEGES":{"pass_condition":"auth_userはSELECTとUPDATE(last_login,password)のみ。属性変更・table全体UPDATE/INSERT/DELETEを許さない。","raw_points":1,"role":"db","title":"認証tableの列権限"},"WEB07_BAD_PASSWORD_DENIED":{"pass_condition":"正規認証の成功を対照に、1回の誤passwordで認証sessionが成立しない。既存passwordの変更や総当たりはしない。","raw_points":1,"role":"bastion","title":"アプリ誤認証の拒否"},"WEB07_CODE_PROTECTED":{"pass_condition":"実行catalog userはコード/venv/親directoryを改変できず、非login・非sudoである。","raw_points":1,"role":"web","title":"コード保護"},"WEB07_ITEM_PRIVILEGES":{"pass_condition":"catalog_itemはSELECT/INSERT/UPDATEのみ。DELETE・権限委譲を許さない。所有者/PUBLIC/membership経由も含める。","raw_points":1,"role":"db","title":"備品tableの実効権限"},"WEB07_MIGRATION_PRIVILEGES":{"pass_condition":"runtimeはdjango_migrations権限・schema CREATE・アプリobject所有権を持たず、既定外の実効許可もない。","raw_points":1,"role":"db","title":"schema/migrationの保護"},"WEB07_PRIVATE_DATA_HIDDEN":{"pass_condition":"対象DBの非公開備品が一般画面へ出ず、公開備品は同じ回に表示される。","raw_points":1,"role":"bastion","title":"非公開備品の保護"},"WEB07_PUBLIC_ADMIN_DENIED":{"pass_condition":"公開80の/adminおよび配下・表記揺れがNginx/アプリで拒否され、偽装headerでも管理画面を返さない。","raw_points":1,"role":"web","title":"一般入口の管理拒否"},"WEB07_SECRET_HTTP_DENIED":{"pass_condition":"秘密をstatic/public配下へ置かず、固定した秘密path候補を一般HTTPで取得できない。","raw_points":1,"role":"web","title":"秘密のHTTP非公開"},"WEB07_SECRET_PERMISSIONS":{"pass_condition":"app.env/有効runtime秘密fileはroot:root0600、linkではなく、catalog等から読取り不可。内容は送信しない。","raw_points":1,"role":"web","title":"秘密fileの権限"},"WEB07_SEQUENCE_PRIVILEGES":{"pass_condition":"必要な備品/admin log ID sequenceはUSAGEだけ。他の過剰権限とsetvalを許すUPDATEがない。nextval/setvalを実行して試さない。","raw_points":1,"role":"db","title":"sequenceの実効権限"},"WEB07_SESSION_PRIVILEGES":{"pass_condition":"django_sessionはSELECT/INSERT/UPDATE/DELETEのみを許す。必要なDELETEを一律禁止しない。","raw_points":1,"role":"db","title":"sessionの権限"},"WEB07_SETUP_RETIRED":{"pass_condition":"対応setup roleはNOLOGIN/password NULL/既存sessionなし。一時setup.envも終了している。","raw_points":1,"role":"db","title":"初期化権限の終了"},"WEB_READY_DEPENDENCIES":{"pass_condition":"課題が利用するHTTP・通常DNS・DB・アプリの現在の必要機能を確認する。前提への再加点はしない。","raw_points":0,"role":"bastion","title":"現在の必要機能"},"WEB_READY_IDENTITY":{"pass_condition":"account/Lab/Deployment/登録5台を照合し、取り違えを拒否する。","raw_points":0,"role":"bastion","title":"本人配備との一致"},"WEB_READY_MANAGEMENT":{"pass_condition":"当該検査に必要なSSM/SSHと対象hostへの管理経路が使える。","raw_points":0,"role":"bastion","title":"観測経路"},"WEB_READY_NETWORK_BASELINE":{"pass_condition":"D08の全5台SSM・50 CIDR限定RDP・内部SSH・公開80・限定送信を確認。SG/route/全ENIを含み、自動提供した境界には加点しない。","raw_points":0,"role":"bastion","title":"配布済み通信境界"},"WEB_READY_PACKAGE_SOURCE":{"pass_condition":"当該課題に必要な署名済み配布元が使える。導入済みpackageを初期未導入条件で拒否しない。","raw_points":0,"role":"repo","title":"配布元"}},"contract_id":"web-d11-2026-10-r1","profiles":{"mission":{"app_admin":"lab_admin","db_name":"jdu_catalog","db_runtime_env":"/etc/jdu-web/db-mission.runtime.env","records":[{"code":"M5-PUBLIC-001","is_public":true,"location":"Lab cabinet C","name":"Mission monitor","quantity":6},{"code":"M5-PRIVATE-001","is_public":false,"location":"Lab cabinet D","name":"Mission router","quantity":1}],"runtime_role":"catalog_app","setup_role":"catalog_setup"},"practice":{"app_admin":"practice_admin","db_name":"jdu_catalog_practice","db_runtime_env":"/etc/jdu-web/db-practice.runtime.env","records":[{"code":"P5-PUBLIC-001","is_public":true,"location":"Training sh