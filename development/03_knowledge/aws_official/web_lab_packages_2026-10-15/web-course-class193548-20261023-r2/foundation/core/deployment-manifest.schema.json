{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JDU Web Lab deployment manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "created_at", "expires_at", "region", "ami", "network", "grading", "bootstrap", "signing", "artifacts"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "release_id": {"type": "string", "pattern": "^web-[0-9]{4}-[0-9]{2}-r[1-9][0-9]*$", "maxLength": 64},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "expires_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "region": {"type": "string", "pattern": "^[a-z]{2}(?:-[a-z]+)+-[1-9][0-9]*$", "maxLength": 32},
    "ami": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner_id", "image_name", "architecture", "ubuntu", "root_device_name", "root_min_gib"],
      "properties": {
        "id": {"type": "string", "pattern": "^ami-[0-9a-f]{17}$"},
        "owner_id": {"type": "string", "const": "099720109477"},
        "image_name": {"type": "string", "pattern": "^ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24\\.04-amd64-server-[0-9]{8}$"},
        "architecture": {"type": "string", "const": "x86_64"},
        "ubuntu": {"type": "string", "const": "24.04"},
        "root_device_name": {"type": "string", "enum": ["/dev/sda1", "/dev/xvda"]},
        "root_min_gib": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["vpc_cidr", "public_subnet_cidr", "private_subnet_cidr", "s3_prefix_list_id", "rdp_ipv4_cidrs"],
      "properties": {
        "vpc_cidr": {"type": "string", "const": "10.20.0.0/16"},
        "public_subnet_cidr": {"type": "string", "const": "10.20.1.0/24"},
        "private_subnet_cidr": {"type": "string", "const": "10.20.2.0/24"},
        "s3_prefix_list_id": {"type": "string", "pattern": "^pl-(?:[0-9a-f]{8}|[0-9a-f]{17})$"},
        "rdp_ipv4_cidrs": {"type": "array", "minItems": 50, "maxItems": 50, "uniqueItems": true,
          "items": {"type": "string", "minLength": 9, "maxLength": 18}}
      }
    },
    "grading": {
      "type": "object", "additionalProperties": false,
      "required": ["ipv4", "fqdn", "submit_path"],
      "properties": {
        "ipv4": {"type": "string", "minLength": 7, "maxLength": 15},
        "fqdn": {"type": "string", "minLength": 4, "maxLength": 253},
        "submit_path": {"type": "string", "const": "/api/web/submit"}
      }
    },
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["bucket", "release_prefix"],
      "properties": {
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "release_prefix": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*/$"}
      }
    },
    "signing": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_fingerprint"],
      "properties": {"primary_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"}}
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_bundle", "template", "selector", "wrapper", "validation", "schema", "public_key"],
      "properties": {
        "repo_bundle": {"$ref": "#/$defs/artifact"},
        "template": {"$ref": "#/$defs/artifact"},
        "selector": {"$ref": "#/$defs/artifact"},
        "wrapper": {"$ref": "#/$defs/artifact"},
        "validation": {"$ref": "#/$defs/artifact"},
        "schema": {"$ref": "#/$defs/artifact"},
        "public_key": {"$ref": "#/$defs/artifact"},
        "controller_bundle": {"$ref": "#/$defs/artifact"},
        "controller_validation": {"$ref": "#/$defs/artifact"},
        "price_catalog": {"$ref": "#/$defs/artifact"}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592}
      }
    }
  }
}
