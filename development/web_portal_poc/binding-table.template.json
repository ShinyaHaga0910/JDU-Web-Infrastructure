{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Separate experimental Web portal enrollment and challenge table",
  "Resources": {
    "BindingTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {"AttributeName": "pk", "AttributeType": "S"},
          {"AttributeName": "sk", "AttributeType": "S"}
        ],
        "KeySchema": [
          {"AttributeName": "pk", "KeyType": "HASH"},
          {"AttributeName": "sk", "KeyType": "RANGE"}
        ],
        "SSESpecification": {"SSEEnabled": true},
        "TimeToLiveSpecification": {"AttributeName": "expires_at", "Enabled": true},
        "Tags": [{"Key": "Purpose", "Value": "jdu-web-portal-enrollment-poc"}]
      }
    }
  },
  "Outputs": {
    "TableName": {"Value": {"Ref": "BindingTable"}},
    "TableArn": {"Value": {"Fn::GetAtt": ["BindingTable", "Arn"]}}
  }
}
