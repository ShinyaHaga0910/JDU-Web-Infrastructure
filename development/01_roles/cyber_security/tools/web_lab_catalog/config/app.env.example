# Copy to /etc/jdu-catalog/app.env as root:root, mode 0600.
# This is data for systemd EnvironmentFile; never shell-source this file.
# Placeholders intentionally prevent startup. Generate a Lab-specific secret.
DJANGO_SECRET_KEY=<LAB_SPECIFIC_RANDOM_SECRET_AT_LEAST_50_CHARACTERS>
DJANGO_ALLOWED_HOSTS=web.lab.test,admin.lab.test,10.20.1.20,<CURRENT_PUBLIC_IPV4>
DB_HOST=db.lab.test
DB_PORT=5432
DB_NAME=jdu_catalog
DB_USER=catalog_app
DB_PASSWORD=<LAB_SPECIFIC_RUNTIME_DB_PASSWORD_AT_LEAST_16_CHARACTERS>
DJANGO_STATIC_ROOT=/var/lib/jdu-catalog/static
CATALOG_SITE_NAME="JDU 備品カタログ"
