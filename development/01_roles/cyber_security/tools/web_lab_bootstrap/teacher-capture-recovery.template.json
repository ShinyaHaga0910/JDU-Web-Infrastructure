{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Teacher-only read-only recovery of the explicit capture volume root partition; gz+b64 config needs volume_id and root_partition=1 plus two scoped PUT URLs.",
  "Parameters": {
    "RecoveryConfigBase64": {
      "Type": "String",
      "NoEcho": true
    }
  },
  "Resources": {
    "RecoveryInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": "ami-0fa5967347d08d2df",
        "InstanceType": "t3a.small",
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 8,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": "subnet-01b518e6362ee568e",
            "AssociatePublicIpAddress": true,
            "GroupSet": [
              "sg-024d3be441a8d01f6"
            ]
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#cloud-config\n{\"package_update\":false,\"package_upgrade\":false,\"write_files\":[{\"path\":\"/var/lib/jdu-capture-recovery/recover.py\",\"permissions\":\"0600\",\"encoding\":\"gz+b64\",\"content\":\"\"},{\"path\":\"/var/lib/jdu-capture-recovery/config.json\",\"permissions\":\"0600\",\"encoding\":\"gz+b64\",\"content\":\"${RecoveryConfigBase64}\"}],\"runcmd\":[[\"bash\",\"-c\",\"set -o pipefail; python3 /var/lib/jdu-capture-recovery/recover.py 2>&1 | tee /var/log/jdu-capture-recovery.log > /dev/ttyS0\"]],\"power_state\":{\"mode\":\"poweroff\",\"delay\":10,\"timeout\":60,\"condition\":true}}\n"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "jdu-web-capture-recovery-20261015"
          }
        ]
      }
    },
    "CaptureAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": {
          "Ref": "RecoveryInstance"
        },
        "VolumeId": "vol-0f4c6d62f96b6d570"
      }
    }
  },
  "Outputs": {
    "RecoveryInstanceId": {
      "Value": {
        "Ref": "RecoveryInstance"
      }
    }
  }
}
