      "raw_points": 1,
      "title": "秘密のHTTP非公開",
      "pass_condition": "秘密をstatic/public配下へ置かず、固定した秘密path候補を一般HTTPで取得できない。"
    },
    "WEB07_SETUP_RETIRED": {
      "role": "db",
      "raw_points": 1,
      "title": "初期化権限の終了",
      "pass_condition": "対応setup roleはNOLOGIN/password NULL/既存sessionなし。一時setup.envも終了している。"
    },
    "WEB07_ITEM_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "備品tableの実効権限",
      "pass_condition": "catalog_itemはSELECT/INSERT/UPDATEのみ。DELETE・権限委譲を許さない。所有者/PUBLIC/membership経由も含める。"
    },
    "WEB07_AUTH_USER_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "認証tableの列権限",
      "pass_condition": "auth_userはSELECTとUPDATE(last_login,password)のみ。属性変更・table全体UPDATE/INSERT/DELETEを許さない。"
    },
    "WEB07_AUTH_LOOKUP_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "認証参照の権限",
      "pass_condition": "auth_group/auth_permission/関連中間table/content_typeはSELECTのみ。"
    },
    "WEB07_SESSION_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "sessionの権限",
      "pass_condition": "django_sessionはSELECT/INSERT/UPDATE/DELETEのみを許す。必要なDELETEを一律禁止しない。"
    },
    "WEB07_AUDIT_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "管理logの権限",
      "pass_condition": "django_admin_logはSELECT/INSERTのみ。UPDATE/DELETEを許さない。"
    },
    "WEB07_MIGRATION_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "schema/migrationの保護",
      "pass_condition": "runtimeはdjango_migrations権限・schema CREATE・アプリobject所有権を持たず、既定外の実効許可もない。"
    },
    "WEB07_SEQUENCE_PRIVILEGES": {
      "role": "db",
      "raw_points": 1,
      "title": "sequenceの実効権限",
      "pass_condition": "必要な備品/admin log ID sequenceはUSAGEだけ。他の過剰権限とsetvalを許すUPDATEがない。nextval/setvalを実行して試さない。"
    },
    "WEB07_ADMIN_PERMISSIONS": {
      "role": "web",
      "raw_points": 1,
      "title": "アプリ管理者の範囲",
      "pass_condition": "対象管理者はstaffかつ非superuser、備品view/add/changeのみ。削除・user/group管理権限やrouteがない。"
    },
    "WEB07_ANONYMOUS_DENIED": {
      "role": "bastion",
      "raw_points": 1,
      "title": "匿名更新の拒否",
      "pass_condition": "正規routeと妥当なCSRF条件で匿名の登録/編集を試し、認証を要求して対象DBを書き換えない。同じ回の正規ログイン/登録成功を対照にする。"
    },
    "WEB07_BAD_PASSWORD_DENIED": {
      "role": "bastion",
      "raw_points": 1,
      "title": "アプリ誤認証の拒否",
      "pass_condition": "正規認証の成功を対照に、1回の誤passwordで認証sessionが成立しない。既存passwordの変更や総当たりはしない。"
    },
    "WEB07_PRIVATE_DATA_HIDDEN": {
      "role": "bastion",
      "raw_points": 1,
      "title": "非公開備品の保護",
      "pass_condition": "対象DBの非公開備品が一般画面へ出ず、公開備品は同じ回に表示される。"
    },
    "WEB_READY_DEPENDENCIES": {
      "role": "bastion",
      "raw_points": 0,
      "title": "現在の必要機能",
      "pass_condition": "課題が利用するHTTP・通常DNS・DB・アプリの現在の必要機能を確認する。前提への再加点はしない。"
    }
  },
